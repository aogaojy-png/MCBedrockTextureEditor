    info.addView(tv(p.date + "   " + p.entries.size() + " 个材质", 12, sub(), false), marginTop(dp(3)));
    row.addView(info, new LinearLayout.LayoutParams(0, -2, 1));

    TextView state = tv("打开", 11, GREEN, true);
