    @Override protected void onActivityResult(int requestCode,int resultCode,Intent data){
        super.onActivityResult(requestCode,resultCode,data);
        if(requestCode==PICK_IMAGE && resultCode==RESULT_OK && data!=null){
            selectedUri=data.getData(); if(selectedUri==null)return;
            try{getContentResolver().takePersistableUriPermission(selectedUri,Intent.FLAG_GRANT_READ_URI_PERMISSION);}catch(Exception ignored){}
            try{Bitmap b=BitmapFactory.decodeStream(getContentResolver().openInputStream(selectedUri)); if(b==null)throw new IOException("无法解析图片"); preview.setImageBitmap(b); selectedText.setText("已选择："+fileName(selectedUri));}catch(Exception e){Toast.makeText(this,"读取失败："+e.getMessage(),Toast.LENGTH_LONG).show();}
        }
        if(requestCode==SAVE_PACK && resultCode==RESULT_OK && data!=null && pendingPack!=null){
            Uri target=data.getData(); if(target==null)return;
            try(InputStream in=new FileInputStream(pendingPack); OutputStream out=getContentResolver().openOutputStream(target)){
                if(out==null)throw new IOException("无法打开保存位置"); byte[] buf=new byte[8192]; int n; while((n=in.read(buf))!=-1)out.write(buf,0,n); out.flush();
                setStatus("材质包已保存"); if(!pendingHistoryName.isEmpty()) saveHistory(pendingHistoryName); Toast.makeText(this,"生成完成！",Toast.LENGTH_LONG).show(); showPage(1);
            }catch(Exception e){Toast.makeText(this,"保存失败："+e.getMessage(),Toast.LENGTH_LONG).show();}
        }
        if(requestCode==2001 && resultCode==RESULT_OK){ Toast.makeText(this,"导入入口已准备好；材质包解析功能将在后续版本完善。",Toast.LENGTH_LONG).show(); }
    }

    private void addEntry(){
        String id=idInput.getText().toString().trim(); String type=typeSpinner.getSelectedItem().toString();
        if(!validId(id)){Toast.makeText(this,"ID 格式错误，需要 namespace:id",Toast.LENGTH_LONG).show();return;}
        if(selectedUri==null){Toast.makeText(this,"请先选择图片",Toast.LENGTH_LONG).show();return;}
        for(Entry e:entries)if(e.id.equals(id)&&e.type.equals(type)){Toast.makeText(this,"这个项目已经存在",Toast.LENGTH_SHORT).show();return;}
        entries.add(new Entry(id,type,selectedUri)); refreshList(); setStatus("已加入："+id); idInput.setText(""); selectedUri=null; preview.setImageDrawable(null); selectedText.setText("尚未选择图片");
    }
    private void refreshList(){if(entries.isEmpty()){listView.setText("暂无项目");return;}StringBuilder s=new StringBuilder();for(int i=0;i<entries.size();i++){Entry e=entries.get(i);s.append(i+1).append(". ").append(e.type).append("  ").append(e.id).append('\n');}listView.setText(s.toString());}
    private void setStatus(String s){if(status!=null)status.setText(s);}

    private void generate(){
        if(entries.isEmpty()){Toast.makeText(this,"请先在编辑器加入至少一个项目",Toast.LENGTH_LONG).show();showEditor();return;}
        try{
            String name=(packNameInput==null?"":packNameInput.getText().toString().trim()); if(name.isEmpty())name="我的基岩材质"; if(!name.toLowerCase(Locale.ROOT).endsWith(".mcpack"))name += ".mcpack";
            String author = authorInput==null ? "熬糕aogao" : authorInput.getText().toString().trim();
            if(author.isEmpty()) author="熬糕aogao";
            String description = descriptionInput==null ? "个人制作的 Minecraft 基岩版材质包" : descriptionInput.getText().toString().trim();
            if(description.isEmpty()) description="个人制作的 Minecraft 基岩版材质包";
            File work=new File(getCacheDir(),"mcpack_build"); delete(work); if(!work.mkdirs())throw new IOException("无法创建工作目录"); buildBedrock(work, author, description);
            pendingPack=new File(getCacheDir(),name); if(pendingPack.exists())pendingPack.delete(); zip(work,pendingPack); pendingHistoryName=name.replace(".mcpack","");
            Intent save=new Intent(Intent.ACTION_CREATE_DOCUMENT);save.setType("application/zip");save.putExtra(Intent.EXTRA_TITLE,name);startActivityForResult(save,SAVE_PACK);
        }catch(Exception e){Toast.makeText(this,"生成失败："+e.getMessage(),Toast.LENGTH_LONG).show();setStatus("生成失败");}
    }

    private void buildBedrock(File root, String author, String description)throws Exception{
        File textures=new File(root,"textures"),items=new File(textures,"items"),blocks=new File(textures,"blocks"),entity=new File(textures,"entity"),env=new File(textures,"environment");
        items.mkdirs();blocks.mkdirs();entity.mkdirs();env.mkdirs(); Map<String,String> itemMap=new LinkedHashMap<>(),terrainMap=new LinkedHashMap<>();
        for(Entry e:entries){String[]p=e.id.split(":",2);String namespace=p[0],id=p[1],base=safe(id);if("物品".equals(e.type)){File out=new File(items,namespace+"_"+base+".png");copyAsPng(e.image,out);itemMap.put(e.id,"textures/items/"+namespace+"_"+base);}else if("方块".equals(e.type)){File out=new File(blocks,namespace+"_"+base+".png");copyAsPng(e.image,out);terrainMap.put(e.id,"textures/blocks/"+namespace+"_"+base);}else if("生物".equals(e.type)){copyAsPng(e.image,new File(entity,namespace+"_"+base+".png"));}else if("天空".equals(e.type)){copyAsPng(e.image,new File(env,"sky.png"));}else if("UI".equals(e.type)){File ui=new File(textures,"ui");ui.mkdirs();copyAsPng(e.image,new File(ui,namespace+"_"+base+".png"));}}
        writeItemTextureJson(new File(textures,"item_texture.json"),itemMap);writeTerrainTextureJson(new File(textures,"terrain_texture.json"),terrainMap);
        String h=UUID.randomUUID().toString(),m=UUID.randomUUID().toString();
        String safeAuthor = author==null||author.trim().isEmpty()?"熬糕aogao":author.trim();
        String manifest="{\n  \"format_version\": 2,\n  \"header\": {\n    \"name\": \"MC 基岩版材质编辑器\",\n    \"description\": \""+json(description)+" | 作者："+json(safeAuthor)+" | 禁止商业使用\",\n    \"uuid\": \""+h+"\",\n    \"version\": [1, 0, 0],\n    \"min_engine_version\": [1, 26, 0]\n  },\n  \"modules\": [{\n    \"type\": \"resources\",\n    \"uuid\": \""+m+"\",\n    \"version\": [1, 0, 0]\n  }]\n}\n";
        write(new File(root,"manifest.json"),manifest);
        String info = "MC 基岩版材质编辑器 - 制作信息\n\n作者："+safeAuthor+"\n开发成员：熬糕aogao\n\n使用许可：仅限个人与非商业用途。\n禁止将本材质包用于商业销售、付费服务、商业宣传或其他商业用途。\n如需商业使用，请先联系作者获得授权。\n\n本文件随材质包一起发布，请勿删除。\n";
        write(new File(root,"制作信息.txt"), info);
    }
    private void writeItemTextureJson(File f,Map<String,String> map)throws Exception{StringBuilder j=new StringBuilder();j.append("{\n  \"resource_pack_name\":\"MC 基岩版材质编辑器\",\n  \"texture_name\":\"atlas.items\",\n  \"texture_data\":{\n");int i=0;for(Map.Entry<String,String>x:map.entrySet()){if(i++>0)j.append(",\n");j.append("    \"").append(json(x.getKey())).append("\":{\"textures\":\"").append(x.getValue()).append("\"}");}j.append("\n  }\n}\n");write(f,j.toString());}
    private void writeTerrainTextureJson(File f,Map<String,String> map)throws Exception{StringBuilder j=new StringBuilder();j.append("{\n  \"resource_pack_name\":\"MC 基岩版材质编辑器\",\n  \"texture_name\":\"atlas.terrain\",\n  \"texture_data\":{\n");int i=0;for(Map.Entry<String,String>x:map.entrySet()){if(i++>0)j.append(",\n");j.append("    \"").append(json(x.getKey())).append("\":{\"textures\":[\"").append(x.getValue()).append("\"]}");}j.append("\n  }\n}\n");write(f,j.toString());}
    private void copyAsPng(Uri uri,File out)throws Exception{Bitmap b=BitmapFactory.decodeStream(getContentResolver().openInputStream(uri));if(b==null)throw new IOException("图片无法解码");File p=out.getParentFile();if(p!=null)p.mkdirs();try(FileOutputStream fos=new FileOutputStream(out)){if(!b.compress(Bitmap.CompressFormat.PNG,100,fos))throw new IOException("PNG 编码失败");}}
    private boolean validId(String id){if(id==null||id.isEmpty())return false;String[]p=id.split(":",-1);return p.length==2&&p[0].matches("[a-z0-9_.-]+")&&p[1].matches("[a-z0-9_./-]+");}
    private String safe(String s){return s.replace(":","_").replaceAll("[^a-zA-Z0-9_.-]","_");}
    private String json(String s){return s.replace("\\","\\\\").replace("\"","\\\"");}
    private String fileName(Uri uri){try(android.database.Cursor c=getContentResolver().query(uri,new String[]{OpenableColumns.DISPLAY_NAME},null,null,null)){if(c!=null&&c.moveToFirst())return c.getString(0);}catch(Exception ignored){}return uri.toString();}
    private void write(File f,String s)throws Exception{File p=f.getParentFile();if(p!=null)p.mkdirs();try(FileOutputStream o=new FileOutputStream(f)){o.write(s.getBytes(StandardCharsets.UTF_8));}}
    private void zip(File dir,File out)throws Exception{try(ZipOutputStream z=new ZipOutputStream(new BufferedOutputStream(new FileOutputStream(out)))){zipRec(dir,dir,z);}}
    private void zipRec(File root,File f,ZipOutputStream z)throws Exception{File[]list=f.listFiles();if(list==null)return;for(File x:list){String name=root.toURI().relativize(x.toURI()).getPath();if(x.isDirectory())zipRec(root,x,z);else{z.putNextEntry(new ZipEntry(name));try(InputStream in=new BufferedInputStream(new FileInputStream(x))){byte[]b=new byte[8192];int n;while((n=in.read(b))!=-1)z.write(b,0,n);}z.closeEntry();}}}
    private void delete(File f){if(!f.exists())return;File[]list=f.listFiles();if(list!=null)for(File x:list)delete(x);f.delete();}
