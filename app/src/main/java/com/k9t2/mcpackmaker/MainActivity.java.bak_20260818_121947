        add.setOnClickListener(v -> addEntry());
        root.addView(add, marginTop(dp(10)));
        listView = tv("暂无项目", 13, sub(), false);
        root.addView(listView, marginTop(dp(10)));
        TextView clear = secondaryButton("清空编辑列表");
        clear.setOnClickListener(v -> { entries.clear(); refreshList(); setStatus("已清空编辑列表"); });
