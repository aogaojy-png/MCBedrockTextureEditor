        Window w = d.getWindow();
        if (w != null) { w.setBackgroundDrawable(round(bg(), 24, line(), 1)); w.setLayout(-1, -1); }
        d.setOnDismissListener(x -> { if (packNameInput != null) showPage(2); });
        d.show();
        if (d.getWindow() != null) d.getWindow().setLayout(-1, -1);
    }

