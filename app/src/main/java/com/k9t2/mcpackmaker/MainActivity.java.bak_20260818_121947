    private static class History { String name, date; int count; History(String n,String d,int c){name=n;date=d;count=c;} }
    private ArrayList<History> loadHistory() {
        ArrayList<History> out = new ArrayList<>();
        String raw = getPreferences(MODE_PRIVATE).getString("history", ""); if (raw.isEmpty()) return out;
        for (String line : raw.split("\\n")) { String[] p=line.split("\\|",-1); if(p.length>=3){try{out.add(new History(p[0],p[1],Integer.parseInt(p[2])));}catch(Exception ignored){}} }
        return out;
    }
    private void saveHistory(String name) {
        ArrayList<History> h=loadHistory(); String date=new SimpleDateFormat("yyyy-MM-dd HH:mm",Locale.getDefault()).format(new Date());
        h.add(0,new History(name,date,entries.size())); while(h.size()>20)h.remove(h.size()-1);
        StringBuilder s=new StringBuilder(); for(History x:h)s.append(x.name.replace("|","_")).append('|').append(x.date).append('|').append(x.count).append('\n');
        getPreferences(MODE_PRIVATE).edit().putString("history",s.toString()).apply();
    }

