    private int sub() { return darkMode ? Color.rgb(167, 175, 188) : Color.rgb(100, 108, 120); }
    private int line() { return darkMode ? Color.rgb(53, 60, 70) : Color.rgb(228, 232, 239); }

    private void showPage(int page) {
        currentPage = page;
        pageHost.removeAllViews();
        pageHost.setBackgroundColor(bg());
        if (page == 0) buildHome();
        else if (page == 1) buildEditorList();
        else if (page == 2) buildGenerator();
        else buildMine();
        refreshBottomNav();
        styleWindow();
    }

    private void refreshBottomNav() {
        if (bottomNav == null) return;
        bottomNav.removeAllViews();
        bottomNav.setBackgroundColor(darkMode ? Color.rgb(22, 26, 33) : Color.WHITE);
        String[] icons = {"⌂", "☷", "✦", "♙"};
        String[] labels = {"首页", "编辑列表", "生成", "我的"};
        for (int i = 0; i < 4; i++) {
            final int p = i;
            LinearLayout item = new LinearLayout(this);
            item.setOrientation(LinearLayout.VERTICAL);
            item.setGravity(Gravity.CENTER);
            item.setPadding(dp(3), dp(4), dp(3), dp(2));
            TextView icon = tv(icons[i], 23, i == currentPage ? GREEN : sub(), true);
            icon.setGravity(Gravity.CENTER);

            TextView label = tv(labels[i], 12, i == currentPage ? GREEN : sub(), false);
            label.setGravity(Gravity.CENTER);
            item.addView(icon, new LinearLayout.LayoutParams(-1, dp(32)));
            item.addView(label, new LinearLayout.LayoutParams(-1, dp(22)));
            item.setOnClickListener(v -> showPage(p));
            bottomNav.addView(item, new LinearLayout.LayoutParams(dp(82), -1));
        }
    }

